 // This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role{
  SUPERADMIN
  DEAN
  TEAMLEAD
  TEACHER
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum CognitiveLevel {
  LOTS
  HOTS
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

enum QuestionStatus {
  APPROVED
  PENDING_REVIEW
  PENDING_REVISION
}

enum RequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum GuidanceStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum BadgeCategory {
  QUEST
  STREAK
  BOSS
  SUBJECT
  EXAM
  PERFORMANCE
  SPEED
  MASTERY
  SPECIAL
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED
}

// [ Admin Schema ]

model AdminUser {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId String @unique
  email     String   @unique
  password  String
  name      String
  firstName String?
  lastName  String?
  role      Role
  phoneNumber String
  avatarUrl String?

  createdSubjects Subject[] @relation("SubjectAuthor")
  handledSubjects Subject[] @relation("HandledSubjects", fields: [handledSubjectIds], references: [id])
  handledSubjectIds String[] @db.ObjectId @map("handledSubjectIds")
  authoredModules LearningModule[] @relation("ModuleAuthor")

  questionPermissions Json?
  notificationPreferences Json?

  location  String?  @default("Philippines")
  accountStatus AccountStatus @default(ACTIVE)
  isActive  Boolean  @default(true)
  lastActiveAt DateTime? @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[] @relation("QuestionAuthor")
  questionComments QuestionComment[] @relation("QuestionCommentAuthor")
  assignedStudents GuidanceAssignment[] @relation("AdvisorGuidance")
  createdGuidanceAssignments GuidanceAssignment[] @relation("AssignerGuidance")
  sentOutreaches OutreachLog[] @relation("AdvisorOutreachLogs")
  quotaAssignments QuestionQuotaAssignment[] @relation("TeacherQuotaAssignments")
  assignedQuotas   QuestionQuotaAssignment[] @relation("AssignedByQuotas")
}

model Question {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  question      String
  imageUrl      String?
  choices       String[]
  choiceImages  String[] @default([])
  correctAnswer String
  status        QuestionStatus @default(APPROVED)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String @db.ObjectId @map("categoryId")
  topic String

  difficulty QuestionDifficulty
  cognitiveLevel CognitiveLevel @default(LOTS)

  type QuestionType

  author   AdminUser @relation("QuestionAuthor", fields: [authorId], references: [id])
  authorId String    @db.ObjectId

  schoolYear String? @default("S.Y. 2025-2026")
  feedback   String? @default("")

  aiExplanation QuestionExplanation?
  comments QuestionComment[]
  attempts UserQuestionAttempt[]
}

model QuestionExplanation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  questionId  String   @unique @db.ObjectId
  explanation String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionComment {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  questionId String    @db.ObjectId
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String    @db.ObjectId
  author     AdminUser @relation("QuestionCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content    String
  isResolved Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model SchoolYear {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  year      String   @unique
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subject {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name String
  icon String
  questions Question[] 
  modules   LearningModule[]
  quotaAssignments QuestionQuotaAssignment[] @relation("SubjectQuotaAssignments")

  handlers    AdminUser[] @relation("HandledSubjects", fields: [handlerIds], references: [id])
  handlerIds  String[]    @db.ObjectId

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author   AdminUser @relation("SubjectAuthor", fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorId String    @db.ObjectId
}

model LearningModule {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  fileUrls    String[] @default([])
  order       Int      @default(0)
  isPublished Boolean  @default(true)

  subjectId   String   @db.ObjectId @map("categoryId")
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  authorId    String?  @db.ObjectId
  author      AdminUser? @relation("ModuleAuthor", fields: [authorId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuestionQuotaAssignment {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  teacherId      String    @db.ObjectId
  teacher        AdminUser @relation("TeacherQuotaAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId      String    @db.ObjectId
  subject        Subject   @relation("SubjectQuotaAssignments", fields: [subjectId], references: [id], onDelete: Cascade)
  assignedById   String?   @db.ObjectId
  assignedBy     AdminUser? @relation("AssignedByQuotas", fields: [assignedById], references: [id])
  schoolYear     String    @default("S.Y. 2025-2026")
  targetCount    Int       @default(50)
  deadline       DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([teacherId, subjectId, schoolYear])
}

// [ Review Center Schema ]

model ReviewCenter {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String   @unique
  code           String?  @unique
  description    String?
  logoUrl        String?
  address        String?
  location       String?  @default("Philippines")
  contactEmail   String?
  contactPhone   String?
  website        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  representatives ReviewCenterRepresentativeUser[]
  programs        ReviewCenterProgram[]
  candidates      ReviewCenterCandidate[]
  schoolYears     ReviewCenterSchoolYear[]
  assessments     ReviewCenterAssessment[]
  scores          ReviewCenterScore[]
}

model ReviewCenterRepresentativeUser {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  employeeId     String
  name           String
  firstName      String?
  lastName       String?
  email          String        @unique
  companyName    String
  phonenumber    String
  password       String
  location       String?       @default("Philippines")
  avatarUrl      String?
  accountStatus  AccountStatus @default(ACTIVE)
  isActive       Boolean       @default(true)
  lastActiveAt   DateTime?     @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  reviewCenter   ReviewCenter? @relation(fields: [reviewCenterId], references: [id], onDelete: SetNull)
  reviewCenterId String?       @db.ObjectId
}

model ReviewCenterProgram {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String?
  companyName    String?
  category       String?
  reviewCenterId String?       @db.ObjectId
  reviewCenter   ReviewCenter? @relation(fields: [reviewCenterId], references: [id], onDelete: SetNull)
  startDate      DateTime?
  endDate        DateTime?
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ReviewCenterSchoolYear {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  schoolYear     String
  isCurrent      Boolean       @default(false)
  status         String        @default("ACTIVE")
  companyName    String
  reviewCenterId String?       @db.ObjectId
  reviewCenter   ReviewCenter? @relation(fields: [reviewCenterId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ReviewCenterCandidate {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  reviewCenterId String?       @db.ObjectId
  reviewCenter   ReviewCenter? @relation(fields: [reviewCenterId], references: [id], onDelete: SetNull)
  companyName    String
  name           String
  email          String
  schoolId       String?
  schoolYear     String        @default("2026-2027")
  batch          String        @default("Batch 1")
  status         String        @default("ENROLLED")
  studentId      String?       @db.ObjectId
  student        User?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  enrolledAt     DateTime      @default(now())
  scores         ReviewCenterScore[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ReviewCenterAssessment {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  reviewCenterId String?       @db.ObjectId
  reviewCenter   ReviewCenter? @relation(fields: [reviewCenterId], references: [id], onDelete: SetNull)
  companyName    String
  title          String
  customLabel    String?
  subject        String        // Predefined MedTech subject
  schoolYear     String        @default("2026-2027")
  batch          String        @default("Batch 1")
  maxScore       Float         @default(100)
  passingScore   Float         @default(75)
  passingRate    Float         @default(75)
  assessmentDate DateTime?
  isPublished    Boolean       @default(false)
  
  meanScore      Float?
  medianScore    Float?
  modeScore      Float[]       @default([])
  highestScore   Float?
  lowestScore    Float?
  passCount      Int           @default(0)
  failCount      Int           @default(0)

  scores         ReviewCenterScore[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ReviewCenterScore {
  id             String                 @id @default(auto()) @map("_id") @db.ObjectId
  reviewCenterId String?                @db.ObjectId
  reviewCenter   ReviewCenter?          @relation(fields: [reviewCenterId], references: [id], onDelete: SetNull)
  companyName    String?
  assessmentId   String                 @db.ObjectId
  assessment     ReviewCenterAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidateId    String                 @db.ObjectId
  candidate      ReviewCenterCandidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  score          Float?
  percentage     Float?
  percentile     Float?
  status         String                 @default("PRESENT") // PRESENT | ABSENT | EXCUSED | INCOMPLETE
  emailStatus    String                 @default("NOT_SENT") // NOT_SENT | PENDING | SENT | FAILED
  emailSentAt    DateTime?
  remarks        String?
  recordedBy     String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([assessmentId, candidateId])
}

// [ User Schema ]

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  firstName String?
  lastName  String?
  verified  Boolean  @default(false)
  level     Int      @default(1)
  xp        Int      @default(0)
  streak    Int      @default(0)
  inventory String?  @default("{}")
  equippedItem String? @default("none")
  location  String?  @default("Philippines")
  avatarUrl String?
  createdAt DateTime @default(now())
  lastContactedAt DateTime?

  studyPlans         StudyPlan[]
  mastery            SubjectMastery[]
  achievements       Achievement[]
  examResults        ExamResult[]
  lessonCompletions  LessonCompletion[]
  guidanceAssignments GuidanceAssignment[] @relation("StudentGuidance")
  outreachLogs       OutreachLog[] @relation("StudentOutreachLogs")
  questNodeCompletions QuestNodeCompletion[]
  questionAttempts   UserQuestionAttempt[]
  userBadges         UserBadge[]
  reviewCenterCandidates ReviewCenterCandidate[]

  @@index([xp])
}

model SubjectMastery {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  subject     String
  proficiency Int      @default(0)
  minScore    Int      @default(0)
  status      String   @default("In Training")
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject])
}

model LessonCompletion {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  subject   String   // Subject category (e.g., 'Clinical Chemistry')
  lessonId  String   // Lesson ID (e.g., 'cc1')
  status    String   // 'completed' | 'in-progress' | 'not-started'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, status])
}

model StudyPlan {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  subject    String
  targetDate DateTime?
  startDate  DateTime? @default(now())
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject])
}

model Achievement {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  task             String
  type             String   // 'quest' | 'exam'
  badge            String?  // Badge ID earned (e.g., 'gold', 'bronze', 'speed')
  xp               Int
  confidenceLevel  String?  // 'Shaky' | 'Steady' | 'Unyielding'
  accuracy         Float?   // Percentage accuracy (0-100)
  questMode        String?  // 'learning' | 'test'
  subject          String?  // Subject for quest tracking (e.g., 'Clinical Chemistry')
  timestamp        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([userId, type, timestamp])
}

model ExamResult {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  score     Int
  total     Int
  accuracy  Float
  subject   String?  // Subject for quest tracking (e.g., 'Clinical Chemistry')
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([userId, subject])
}

enum LogLevel {
  INFO
  WARN
  ERROR
  FATAL
}

model SystemLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  level     LogLevel @default(INFO)
  action    String
  message   String
  source    String?  @default("System")
  userEmail String?
  ipAddress String?
  metadata  String?
  createdAt DateTime @default(now())
}

model AiAnalysis {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  analysis  String   // JSON string of the analysis
  hash      String   // Hash of the data used to generate the analysis
  updatedAt DateTime @updatedAt
}

model GuidanceAssignment {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  student          User           @relation("StudentGuidance", fields: [studentId], references: [id], onDelete: Cascade)
  studentId        String         @db.ObjectId
  advisor          AdminUser      @relation("AdvisorGuidance", fields: [advisorId], references: [id], onDelete: Cascade)
  advisorId        String         @db.ObjectId
  assignedBy       AdminUser      @relation("AssignerGuidance", fields: [assignedById], references: [id], onDelete: Cascade)
  assignedById     String         @db.ObjectId
  status           GuidanceStatus @default(PENDING)
  subjectCategory  String?
  reason           String
  guidanceNotes    String?        @default("")
  resolutionNotes  String?        @default("")
  drillQuota       Int?           @default(30)
  targetAccuracy   Float?         @default(75.0)
  deadline         DateTime?
  lastOutreachAt   DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model OutreachLog {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  student         User           @relation("StudentOutreachLogs", fields: [studentId], references: [id], onDelete: Cascade)
  studentId       String         @db.ObjectId
  advisor         AdminUser      @relation("AdvisorOutreachLogs", fields: [advisorId], references: [id], onDelete: Cascade)
  advisorId       String         @db.ObjectId
  guidanceId      String?        @db.ObjectId

  channel         String         @default("EMAIL") // EMAIL, IN_APP, SYSTEM_ALERT
  subject         String
  message         String
  templateType    String?        // CHECKIN, REMEDIAL, CONSULTATION, COMMENDATION, CUSTOM
  focusSubject    String?        // e.g. "Microbiology", "Clinical Chemistry"
  meetingLink     String?

  deliveryStatus  String         @default("SENT") // SENT, DELIVERED, FAILED
  readAt          DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([studentId, createdAt])
  @@index([advisorId, createdAt])
  @@map("OutreachLogs")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  QUESTION_APPROVED
  STUDENT_ASSIGNED
  SYSTEM_UPDATE
}

model Notification {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  recipientId   String?
  recipientRole String?
  title         String
  message       String
  type          NotificationType @default(INFO)
  link          String?
  isRead        Boolean          @default(false)
  readUserIds   String[]
  deletedUserIds String[]
  metadata      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model QuestNodeCompletion {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  subject    String   // Subject category (e.g., 'Clinical Chemistry')
  nodeId     String   // Chapter Node ID (e.g., 'cc-1')
  difficulty String   // 'EASY' | 'MEDIUM' | 'HARD'
  status     String   @default("completed") // 'completed'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId, difficulty])
  @@index([userId, status])
}

model UserQuestionAttempt {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  questionId String   @db.ObjectId
  attempts   Int      @default(0)
  correct    Int      @default(0)
  lastAttempt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model EmailVerification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}


model Badge {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  badgeId         String   @unique // 'gold', 'silver', 'bronze', 'speed', 'streak-7', 'boss-slayer'
  title           String   // 'Master', 'Adept', 'Aspirant', 'Swift Solver', 'Boss Slayer'
  name            String   // 'Gold Quest Badge', 'Silver Quest Badge', 'Speed Master'
  description     String   // Full description of unlock conditions
  category        String   @default("QUEST")
  tier            String?  @default("STANDARD")
  icon            String   // 'trophy', 'flame', 'zap', 'shield', 'crown'
  spriteUrl       String?  // '/ui/gold-badge.png', '/ui/master-badge.png', etc.
  color           String   // Hex color code ('#FFD700', '#C0C0C0', '#CD7F32')
  unlockCondition String   // '100% accuracy in Quest Arena'
  xpReward        Int      @default(50)
  confidenceFactor Float   @default(1.0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userBadges      UserBadge[]
}

model UserBadge {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  badgeId         String?  @db.ObjectId
  badgeSlug       String   // Matches Badge.badgeId (e.g. 'gold', 'speed')
  subject         String?  // Subject area context (e.g. 'Clinical Chemistry')
  questMode       String?  // 'learning' | 'test' | 'boss'
  accuracy        Float?   // Accuracy percentage achieved
  confidenceLevel String?  // 'Shaky' | 'Steady' | 'Unyielding'
  xpEarned        Int      @default(0)
  unlockedAt      DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge? @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeSlug, subject])
  @@index([userId])
  @@index([badgeSlug])
}

model GameConfig {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  key                   String   @unique @default("default")
  baseXP                Int      @default(10)
  xpMultiplier          Float    @default(1.5)
  streakBonusPercentage Int      @default(10)
  accuracyThreshold     Int      @default(70)
  levelUpXpBase         Int      @default(100)
  maxLevelCap           Int      @default(50)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model RankTier {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  rankId      String   @unique
  title       String
  name        String
  description String   @default("")
  minLevel    Int      @default(1)
  maxLevel    Int?
  minXp       Int      @default(0)
  icon        String   @default("Award")
  color       String   @default("#3B82F6")
  spriteUrl   String?
  perks       String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([minLevel])
}

// [ Arena Integrity & Anti-Cheat Warning Schema from BoardQuesters ]

model StudentWarningIncident {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String?
  userName     String
  userEmail    String
  subject      String
  nodeId       String
  quizMode     String   @default("quest")
  incidentType String   // 'FULLSCREEN_EXIT' | 'SCREENSHOT_ATTEMPT' | 'TAB_SWITCH' | 'COPY_ATTEMPT'
  strikeCount  Int      @default(1)
  details      String   @default("")
  weekKey      String?
  timestamp    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([incidentType])
  @@index([timestamp])
  @@map("StudentWarningIncidents")
}

model StudentWarningSummary {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                String    @unique
  userName              String
  userEmail             String

  // Weekly Active Window (Resets each week)
  currentWeekKey        String    @default("") // e.g. "2026-W41"
  weekStartDate         DateTime?
  weeklyWarnings        Int       @default(0)
  weeklyFullscreenExits Int       @default(0)
  weeklyScreenshots     Int       @default(0)
  weeklyTabSwitches     Int       @default(0)
  weeklyCopyAttempts    Int       @default(0)
  weeklyRiskLevel       String    @default("LOW") // 'LOW' | 'MEDIUM' | 'HIGH'

  // All-Time Lifetime Tracking
  allTimeWarnings       Int       @default(0)
  totalWarnings         Int       @default(0) // alias for backwards compatibility
  fullscreenExits       Int       @default(0)
  screenshots           Int       @default(0)
  tabSwitches           Int       @default(0)
  copyAttempts          Int       @default(0)
  riskLevel             String    @default("LOW") // 'LOW' | 'MEDIUM' | 'HIGH'

  lastIncidentType      String?
  lastIncidentAt        DateTime?
  subjectsAffected      String[]  @default([])
  updatedAt             DateTime  @updatedAt

  @@index([weeklyWarnings])
  @@index([allTimeWarnings])
  @@index([totalWarnings])
  @@index([currentWeekKey])
  @@index([riskLevel])
  @@map("StudentWarningSummaries")
}

