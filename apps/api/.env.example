DATABASE_URL="MONGODB DB URL HERE"
JWT_SECRET="YOUR_JWT_SECRET"

PORT="YOUR PORT HERE"

# ── n8n AI Integration ─────────────────────────────────────────────────────
# Base URL of your n8n instance (no trailing slash)
N8N_BASE_URL="http://localhost:5678"

# Webhook paths configured in your n8n workflows
N8N_PARAPHRASE_WEBHOOK_PATH="/webhook/paraphrase-question"
N8N_ANALYSIS_WEBHOOK_PATH="/webhook/analyze-performance"

# Optional: n8n API key for securing webhook endpoints
N8N_API_KEY="YOUR_N8N_API_KEY_HERE"