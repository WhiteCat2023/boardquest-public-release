# ==============================================================================
# BoardQuest API Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Allowed CORS Origins / Client URLs
CLIENT_URL=http://localhost:5175
ADMIN_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Connection (MongoDB)
# ------------------------------------------------------------------------------
# Local MongoDB instance or MongoDB Atlas connection string
DATABASE_URL=mongodb://localhost:27017/boardquest

# ------------------------------------------------------------------------------
# 3. Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# JWT Signing keys used for access and refresh token generation & verification
PRIVATE_KEY=your_super_secure_jwt_private_key_here_change_in_production
PUBLIC_KEY=your_super_secure_jwt_public_key_here_change_in_production
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# ------------------------------------------------------------------------------
# 4. Redis Cache & Distributed Rate Limiting (Optional)
# ------------------------------------------------------------------------------
# If left blank, the API falls back to standard in-memory rate limiting
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 5. Email Service (Resend)
# ------------------------------------------------------------------------------
# Required for account verification, password resets, and automated credentials emails
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM="BoardQuest <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 6. Real-Time Events & Notifications (Pusher Channels)
# ------------------------------------------------------------------------------
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=ap1

# ------------------------------------------------------------------------------
# 7. Supabase Cloud Storage (Image & Media Uploads)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_STORAGE_BUCKET=boardquest-storage

# ------------------------------------------------------------------------------
# 7. AI Services (Google Gemini & n8n Workflows)
# ------------------------------------------------------------------------------
# Google Gemini API Key for Question Synthesizer & Analytics Summaries
GEMINI_API_KEY=your_gemini_api_key_here

# n8n Webhook Automations (Optional)
N8N_BASE_URL=
N8N_WEBHOOK_PARAPHRASE=
N8N_WEBHOOK_ANALYTICS=