# Admin Frontend Environment Variables
VITE_API_URL=http://localhost:3000/api/v1

# Pusher Channels Configuration
VITE_PUSHER_KEY=your_pusher_key_here
VITE_PUSHER_CLUSTER=ap1

# External Services & Portals
VITE_REVIEW_CENTER_URL=http://localhost:5174
VITE_N8N_PARAPHRASE_WEBHOOK_URL=http://localhost:5678/webhook/your_webhook_id_here

# Fetching, Export & File Limits
VITE_EXPORT_FETCH_LIMIT=10000
VITE_BULK_UPLOAD_CHUNK_SIZE=10
VITE_MAX_FILE_SIZE_MB=10
